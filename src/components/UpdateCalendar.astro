---
import { type CollectionEntry, getCollection } from "astro:content";

const allPosts = await getCollection("post");
const allNotes = await getCollection("note");

const allDates = [...allPosts, ...allNotes].map((item) => {
	const date = new Date(item.data.publishDate);
	return date.toISOString().split("T")[0];
});

const dateCount = new Map<string, number>();
allDates.forEach((date) => {
	dateCount.set(date, (dateCount.get(date) || 0) + 1);
});

const today = new Date();
const startDate = new Date(today);
startDate.setMonth(startDate.getMonth() - 8);

const weeks: string[][] = [];
let currentWeek: string[] = [];

const startDay = startDate.getDay();
for (let i = 0; i < startDay; i++) {
	currentWeek.push("");
}

const currentDate = new Date(startDate);
while (currentDate <= today) {
	currentWeek.push(currentDate.toISOString().split("T")[0]);
	if (currentWeek.length === 7) {
		weeks.push(currentWeek);
		currentWeek = [];
	}
	currentDate.setDate(currentDate.getDate() + 1);
}

if (currentWeek.length > 0) {
	while (currentWeek.length < 7) {
		currentWeek.push("");
	}
	weeks.push(currentWeek);
}

const months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];

function getLevel(date: string): number {
	if (!date) return 0;
	const count = dateCount.get(date) || 0;
	if (count === 0) return 0;
	if (count === 1) return 1;
	if (count === 2) return 2;
	if (count <= 4) return 3;
	return 4;
}

const levelColors = [
	"bg-gray-100 dark:bg-gray-700",
	"bg-[#9BE9A8]",
	"bg-[#40C463]",
	"bg-[#30A14E]",
	"bg-[#216E39]",
];
---

<section class="update-calendar-section mt-12">
	<div class="section-header">
		<div class="calendar-header">
			<div class="date-badge">
				{today.getFullYear()}年{today.getMonth() + 1}月{today.getDate()}日
			</div>
			<div class="calendar-title">
				<span class="title-main">Daily</span>
				<span class="title-sub">Log</span>
			</div>
		</div>
	</div>

	<div class="calendar-container">
		<div class="weekday-labels">
			<span class="weekday">一</span>
			<span class="weekday">三</span>
			<span class="weekday">五</span>
			<span class="weekday">日</span>
		</div>

		<div class="calendar-grid">
			{
				weeks.map((week, weekIndex) => (
					<div key={weekIndex} class="calendar-week">
						{week.map((date, dayIndex) => {
							const level = getLevel(date);
							return (
								<div
									key={dayIndex}
									class={`calendar-cell ${levelColors[level]} cursor-pointer transition-all duration-200 hover:ring-2 hover:ring-accent`}
									title={date ? `${date}: ${dateCount.get(date) || 0} 次更新` : ""}
								/>
							);
						})}
					</div>
				))
			}
		</div>

		<div class="month-labels">
			{
				(() => {
					const monthLabels: { month: string; offset: number }[] = [];
					let lastMonth = -1;
					let weekCount = 0;
					for (const week of weeks) {
						for (const date of week) {
							if (date) {
								const month = new Date(date).getMonth();
								if (month !== lastMonth) {
									monthLabels.push({ month: months[month], offset: weekCount });
									lastMonth = month;
								}
								break;
							}
						}
						weekCount++;
					}
					return monthLabels.map((label, index) => (
						<span key={index} class="month-label" style={{ left: `${label.offset * 14 + 7}px` }}>
							{label.month}
						</span>
					));
				})()
			}
		</div>
	</div>

	<div class="calendar-legend">
		<span class="legend-label">少</span>
		<div class="legend-cells">
			<div class={`legend-cell ${levelColors[0]}`}></div>
			<div class={`legend-cell ${levelColors[1]}`}></div>
			<div class={`legend-cell ${levelColors[2]}`}></div>
			<div class={`legend-cell ${levelColors[3]}`}></div>
			<div class={`legend-cell ${levelColors[4]}`}></div>
		</div>
		<span class="legend-label">多</span>
	</div>
</section>

<style>
	.update-calendar-section {
		margin-top: 3rem;
		padding-bottom: 3rem;
	}

	.calendar-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 1.5rem;
		flex-wrap: wrap;
		gap: 1rem;
		max-width: 1200px;
		margin-left: auto;
		margin-right: auto;
		padding-left: 1rem;
		padding-right: 1rem;
	}

	.date-badge {
		padding: 0.5rem 1rem;
		font-size: 0.875rem;
		color: #6b7280;
	}

	.dark .date-badge {
		color: #9ca3af;
	}

	.calendar-title {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
	}

	.title-main {
		font-size: 1.75rem;
		font-weight: 700;
		color: #111827;
	}

	.title-sub {
		font-size: 1rem;
		font-weight: 600;
		color: hsl(var(--theme-accent));
		margin-top: -0.25rem;
	}

	.dark .title-main {
		color: #ffffff;
	}

	.calendar-container {
		position: relative;
		overflow-x: auto;
		padding-bottom: 1rem;
		max-width: 1200px;
		margin-left: auto;
		margin-right: auto;
		padding-left: 1rem;
		padding-right: 1rem;
	}

	.weekday-labels {
		display: flex;
		gap: 2px;
		margin-bottom: 2px;
		padding-left: 2rem;
	}

	.weekday {
		font-size: 0.75rem;
		color: #9ca3af;
		width: 12px;
		text-align: center;
	}

	.calendar-grid {
		display: flex;
		gap: 2px;
	}

	.calendar-week {
		display: flex;
		flex-direction: column;
		gap: 2px;
	}

	.calendar-cell {
		width: 12px;
		height: 12px;
		border-radius: 2px;
	}

	.month-labels {
		position: relative;
		height: 1rem;
		margin-top: 0.5rem;
	}

	.month-label {
		position: absolute;
		font-size: 0.75rem;
		color: #9ca3af;
		transform: translateX(-50%);
	}

	.calendar-legend {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: 0.5rem;
		margin-top: 1rem;
	}

	.legend-label {
		font-size: 0.75rem;
		color: #9ca3af;
	}

	.legend-cells {
		display: flex;
		gap: 2px;
	}

	.legend-cell {
		width: 12px;
		height: 12px;
		border-radius: 2px;
	}

	@media (min-width: 768px) {
		.calendar-cell {
			width: 14px;
			height: 14px;
		}

		.legend-cell {
			width: 14px;
			height: 14px;
		}
	}
</style>
