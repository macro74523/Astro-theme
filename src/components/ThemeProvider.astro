<script is:inline>
	const lightModePref = window.matchMedia("(prefers-color-scheme: light)");

	function getUserPref() {
		const storedTheme = typeof localStorage !== "undefined" && localStorage.getItem("theme");
		return storedTheme || (lightModePref.matches ? "light" : "dark");
	}

	function createTransitionEffect(x, y, newTheme) {
		const overlay = document.createElement("div");
		overlay.className = "theme-transition-overlay";
		document.body.appendChild(overlay);

		const ring1 = document.createElement("span");
		ring1.className = `theme-ring theme-ring-1 ${newTheme === "dark" ? "to-dark" : "to-light"}`;
		ring1.style.left = `${x}px`;
		ring1.style.top = `${y}px`;

		const ring2 = document.createElement("span");
		ring2.className = `theme-ring theme-ring-2 ${newTheme === "dark" ? "to-dark" : "to-light"}`;
		ring2.style.left = `${x}px`;
		ring2.style.top = `${y}px`;

		const fadeLayer = document.createElement("span");
		fadeLayer.className = `theme-fade-layer ${newTheme === "dark" ? "to-dark" : "to-light"}`;

		overlay.appendChild(ring1);
		overlay.appendChild(ring2);
		overlay.appendChild(fadeLayer);

		requestAnimationFrame(() => {
			ring1.classList.add("animate");
			setTimeout(() => ring2.classList.add("animate"), 80);
			setTimeout(() => fadeLayer.classList.add("animate"), 150);
		});

		setTimeout(() => {
			overlay.classList.add("exit");
			setTimeout(() => {
				if (document.body.contains(overlay)) {
					document.body.removeChild(overlay);
				}
			}, 400);
		}, 700);
	}

	function setTheme(newTheme) {
		if (newTheme !== "light" && newTheme !== "dark") {
			return console.warn(
				`Invalid theme value '${newTheme}' received. Expected 'light' or 'dark'.`,
			);
		}

		const root = document.documentElement;
		if (newTheme === root.getAttribute("data-theme")) {
			return;
		}

		root.setAttribute("data-theme", newTheme);

		const colorThemeMetaTag = document.querySelector("meta[name='theme-color']");
		if (colorThemeMetaTag) {
			const bgColour = getComputedStyle(document.body).getPropertyValue("--theme-bg");
			colorThemeMetaTag.setAttribute("content", `hsl(${bgColour})`);
		}

		if (typeof localStorage !== "undefined") {
			localStorage.setItem("theme", newTheme);
		}
	}

	setTheme(getUserPref());

	document.addEventListener("astro:after-swap", () => setTheme(getUserPref()));

	document.addEventListener("theme-change", (e) => {
		createTransitionEffect(e.detail.x, e.detail.y, e.detail.theme);
		setTheme(e.detail.theme);
	});

	lightModePref.addEventListener("change", (e) => setTheme(e.matches ? "light" : "dark"));
</script>

<style>
	.theme-transition-overlay {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		pointer-events: none;
		z-index: 9999;
		transition: opacity 0.4s cubic-bezier(0.4, 0, 0.2, 1);
	}

	.theme-transition-overlay.exit {
		opacity: 0;
	}

	.theme-ring {
		position: absolute;
		width: 60px;
		height: 60px;
		border-radius: 50%;
		transform: translate(-50%, -50%) scale(0);
		transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
	}

	.theme-ring-1 {
		background: radial-gradient(circle, rgba(34, 197, 94, 0.6) 0%, transparent 70%);
	}

	.theme-ring-2 {
		background: radial-gradient(circle, rgba(34, 197, 94, 0.3) 0%, transparent 70%);
		transition-delay: 80ms;
	}

	.theme-ring.to-dark {
		background: radial-gradient(circle, rgba(18, 20, 23, 0.9) 0%, transparent 70%);
	}

	.theme-ring.to-dark.theme-ring-2 {
		background: radial-gradient(circle, rgba(18, 20, 23, 0.6) 0%, transparent 70%);
	}

	.theme-ring.to-light {
		background: radial-gradient(circle, rgba(247, 245, 240, 0.9) 0%, transparent 70%);
	}

	.theme-ring.to-light.theme-ring-2 {
		background: radial-gradient(circle, rgba(247, 245, 240, 0.6) 0%, transparent 70%);
	}

	.theme-ring.animate {
		width: 100vmax;
		height: 100vmax;
		transform: translate(-50%, -50%) scale(2.5);
	}

	.theme-fade-layer {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		opacity: 0;
		transition: opacity 0.5s cubic-bezier(0.4, 0, 0.2, 1);
	}

	.theme-fade-layer.to-dark {
		background: rgba(18, 20, 23, 0.4);
	}

	.theme-fade-layer.to-light {
		background: rgba(247, 245, 240, 0.4);
	}

	.theme-fade-layer.animate {
		opacity: 1;
	}
</style>
