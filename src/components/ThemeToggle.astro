<theme-toggle class="relative">
	<button
		class="theme-toggle-btn group relative flex h-10 w-10 items-center justify-center rounded-full transition-all duration-300 hover:bg-accent/10"
		type="button"
		aria-label="Toggle theme"
	>
		<span class="sr-only">Toggle theme</span>

		<div class="theme-icon-container relative h-6 w-6">
			<svg
				aria-hidden="true"
				class="sun-icon absolute inset-0 h-full w-full"
				fill="none"
				focusable="false"
				stroke-width="1.5"
				viewBox="0 0 24 24"
				xmlns="http://www.w3.org/2000/svg"
			>
				<circle
					cx="12"
					cy="12"
					r="5"
					stroke="currentColor"
					stroke-linecap="round"
					stroke-linejoin="round"></circle>
				<path
					d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"
					stroke="currentColor"
					stroke-linecap="round"
					stroke-linejoin="round"></path>
			</svg>

			<svg
				aria-hidden="true"
				class="moon-icon absolute inset-0 h-full w-full"
				fill="none"
				focusable="false"
				stroke="currentColor"
				stroke-width="1.5"
				viewBox="0 0 24 24"
				xmlns="http://www.w3.org/2000/svg"
			>
				<path
					d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"
					stroke-linecap="round"
					stroke-linejoin="round"></path>
			</svg>
		</div>

		<div class="glow-effect"></div>
	</button>
</theme-toggle>

<script>
	import { rootInDarkMode } from "@/utils/domElement";

	class ThemeToggle extends HTMLElement {
		connectedCallback() {
			const button = this.querySelector("button");
			if (!button) return;

			button.setAttribute("role", "switch");
			button.setAttribute("aria-checked", String(rootInDarkMode()));
			this.updateState(rootInDarkMode());

			button.addEventListener("click", (event) => {
				const newTheme = rootInDarkMode() ? "light" : "dark";

				document.dispatchEvent(
					new CustomEvent("theme-change", {
						detail: {
							theme: newTheme,
							x: event.clientX,
							y: event.clientY,
							buttonRect: button.getBoundingClientRect(),
						},
					}),
				);

				button.setAttribute("aria-checked", String(newTheme === "dark"));
				this.updateState(newTheme === "dark");
			});

			document.addEventListener("theme-change", (e) => {
				button.setAttribute("aria-checked", String(e.detail.theme === "dark"));
				this.updateState(e.detail.theme === "dark");
			});
		}

		updateState(isDark) {
			const container = this.querySelector(".theme-icon-container");
			const sunIcon = this.querySelector(".sun-icon");
			const moonIcon = this.querySelector(".moon-icon");
			const glow = this.querySelector(".glow-effect");

			if (!container || !sunIcon || !moonIcon || !glow) return;

			if (isDark) {
				sunIcon.style.setProperty("--state", "hidden");
				moonIcon.style.setProperty("--state", "visible");
				container.style.setProperty("--rotation", "30deg");
				glow.style.setProperty("--glow-active", "true");
			} else {
				sunIcon.style.setProperty("--state", "visible");
				moonIcon.style.setProperty("--state", "hidden");
				container.style.setProperty("--rotation", "0deg");
				glow.style.setProperty("--glow-active", "false");
			}
		}
	}

	customElements.define("theme-toggle", ThemeToggle);
</script>

<style>
	.theme-toggle-btn {
		position: relative;
		cursor: pointer;
	}

	.theme-icon-container {
		transform: rotate(var(--rotation, 0deg));
		transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
	}

	.theme-icon-container svg {
		transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
	}

	.sun-icon {
		opacity: var(--sun-opacity, 1);
		transform: scale(var(--sun-scale, 1)) rotate(var(--sun-rotate, 0deg));
	}

	.moon-icon {
		opacity: var(--moon-opacity, 0);
		transform: scale(var(--moon-scale, 0.8)) rotate(var(--moon-rotate, -30deg));
	}

	.theme-icon-container:has(.sun-icon[style*="--state: hidden"]) .sun-icon {
		--sun-opacity: 0;
		--sun-scale: 0.8;
		--sun-rotate: 30deg;
	}

	.theme-icon-container:has(.moon-icon[style*="--state: visible"]) .moon-icon {
		--moon-opacity: 1;
		--moon-scale: 1;
		--moon-rotate: 0deg;
	}

	.theme-icon-container:has(.sun-icon[style*="--state: visible"]) .sun-icon {
		--sun-opacity: 1;
		--sun-scale: 1;
		--sun-rotate: 0deg;
	}

	.theme-icon-container:has(.moon-icon[style*="--state: hidden"]) .moon-icon {
		--moon-opacity: 0;
		--moon-scale: 0.8;
		--moon-rotate: -30deg;
	}

	.glow-effect {
		position: absolute;
		inset: -2px;
		border-radius: 50%;
		background: radial-gradient(circle, rgba(34, 197, 94, 0.3) 0%, transparent 70%);
		opacity: var(--glow-opacity, 0);
		transform: scale(var(--glow-scale, 0.8));
		transition:
			opacity 0.4s cubic-bezier(0.4, 0, 0.2, 1),
			transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
		pointer-events: none;
	}

	.glow-effect[style*="--glow-active: true"] {
		--glow-opacity: 1;
		--glow-scale: 1.2;
	}

	.glow-effect[style*="--glow-active: false"] {
		--glow-opacity: 0;
		--glow-scale: 0.8;
	}

	.theme-toggle-btn:hover .glow-effect {
		opacity: 0.3;
		transform: scale(1);
	}
</style>
