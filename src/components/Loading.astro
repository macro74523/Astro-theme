<div id="loading" class="fixed inset-0 z-[9999] flex items-center justify-center bg-bgColor">
	<div class="flex flex-col items-center gap-4">
		<img
			alt="loading"
			class="h-24 w-auto"
			src="https://img.cdn1.vip/i/69f9573b5292f_1777948475.webp"
		/>
		<span class="text-sm text-textColor/70">加载中...</span>
	</div>
</div>

<script>
	window.addEventListener("load", () => {
		const loading = document.getElementById("loading");
		if (loading) {
			loading.style.opacity = "0";
			setTimeout(() => {
				loading.style.display = "none";
			}, 300);
		}
	});
</script>

<style>
	#loading {
		transition: opacity 0.3s ease;
	}
</style>
