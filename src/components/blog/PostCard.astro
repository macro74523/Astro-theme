---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

type Props = {
	post: CollectionEntry<"post">;
};

const { post } = Astro.props;

const isImageUrl = (str?: string) => str?.startsWith("http");
const isBV = (str?: string) => str?.startsWith("BV");
---

<article class="group relative flex flex-col overflow-hidden rounded-lg border border-accent/20 bg-bgColor transition-all hover:border-accent/40 hover:shadow-lg hover:shadow-accent/5 dark:border-accent-2/20 dark:bg-accent-2/5 dark:hover:border-accent-2/40 dark:hover:shadow-accent-2/5">
	<a class="absolute inset-0 z-10" data-astro-prefetch href={`/posts/${post.id}/`}>
		<span class="sr-only">阅读 {post.data.title}</span>
	</a>

	{post.data.coverImage && isImageUrl(post.data.coverImage.src) && (
		<div class="aspect-[16/9] overflow-hidden">
			<img
				alt={post.data.coverImage.alt}
				class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
				src={post.data.coverImage.src}
			/>
		</div>
	)}

	{post.data.coverImage && !isImageUrl(post.data.coverImage.src) && !isBV(post.data.ogImage) && (
		<div class="aspect-[16/9] overflow-hidden">
			<Image
				alt={post.data.coverImage.alt}
				class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
				src={post.data.coverImage.src}
			/>
		</div>
	)}

	{isImageUrl(post.data.ogImage) && !post.data.coverImage && (
		<div class="aspect-[16/9] overflow-hidden">
			<img
				alt={post.data.title}
				class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
				src={post.data.ogImage}
			/>
		</div>
	)}

	{isBV(post.data.ogImage) && !post.data.coverImage && (
		<div class="aspect-[16/9] overflow-hidden">
			<img
				alt={post.data.title}
				class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
				data-bv={post.data.ogImage}
				src=""
			/>
		</div>
	)}

	<div class="flex flex-1 flex-col p-4">
		<div class="mb-2 flex items-center gap-2">
			<h2 class="text-lg font-semibold leading-tight text-accent-2 transition-colors group-hover:text-accent dark:text-accent-2 dark:group-hover:text-accent-2">
				{post.data.title}
			</h2>
			{post.data.tags?.length > 0 && (
				<span class="shrink-0 rounded-full bg-accent/10 px-2 py-0.5 text-xs text-accent dark:bg-accent-2/10 dark:text-accent-2">
					{post.data.tags[0]}
				</span>
			)}
		</div>

		<p class="line-clamp-2 flex-1 text-sm text-gray-700 dark:text-gray-300">
			{post.data.description}
		</p>

		<div class="mt-4 flex items-center justify-end">
			<span class="text-lg text-accent/50 transition-all group-hover:text-accent group-hover:translate-x-1 dark:text-accent-2/50">
				→
			</span>
		</div>
	</div>
</article>

<script is:inline>
document.addEventListener("DOMContentLoaded", () => {
	document.querySelectorAll("img[data-bv]").forEach((img) => {
		const bvid = img.getAttribute("data-bv");
		if (!bvid) return;

		fetch(`https://api.bilibili.com/x/web-interface/view?bvid=${bvid}`)
			.then((res) => res.json())
			.then((data) => {
				if (data.code === 0 && data.data?.pic) {
					img.src = data.data.pic;
				}
			})
			.catch(() => {});
	});
});
</script>