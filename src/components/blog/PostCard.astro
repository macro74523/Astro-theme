---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

type Props = {
	post: CollectionEntry<"post">;
};

const { post } = Astro.props;

const hasExternalImage = (str?: string) => {
	if (!str) return false;
	return str.startsWith("http://") || str.startsWith("https://");
};

const coverSrc = post.data.coverImage?.src;
const ogImage = post.data.ogImage;
const hasCover = hasExternalImage(ogImage) || !!coverSrc;
---

<article
	class:list={[
		"group relative flex flex-col overflow-hidden rounded border border-accent/20 bg-bgColor transition-all duration-300 hover:-translate-y-1 hover:border-accent/40 hover:shadow-xl hover:shadow-accent/10 dark:border-accent-2/20 dark:bg-accent-2/5 dark:hover:border-accent-2/40 dark:hover:shadow-accent-2/10",
		!hasCover && "post-card-no-cover",
	]}
	style="break-inside: avoid;"
>
	<a class="absolute inset-0 z-10" data-astro-prefetch href={`/posts/${post.id}/`}>
		<span class="sr-only">阅读 {post.data.title}</span>
	</a>

	{
		hasCover && (
			<div class="card-cover">
				{hasExternalImage(ogImage) && <img alt={post.data.title} class="cover-img" src={ogImage} />}

				{coverSrc && !hasExternalImage(ogImage) && (
					<Image alt={post.data.coverImage.alt} class="cover-img" src={coverSrc} />
				)}

				{post.data.tags?.length > 0 && <span class="card-tag">{post.data.tags[0]}</span>}
			</div>
		)
	}

	<div class="flex flex-1 flex-col p-4">
		<h2
			class="line-clamp-1 text-base font-semibold leading-tight text-accent-2 transition-colors group-hover:text-accent dark:text-accent-2 dark:group-hover:text-accent-2 lg:text-lg"
			title={post.data.title}
		>
			{post.data.title}
		</h2>

		{
			!hasCover && (
				<p class="mt-2 line-clamp-2 flex-1 text-sm text-gray-700 dark:text-gray-300">
					{post.data.description}
					{post.data.tags?.length > 0 && <span class="tag-inline">#{post.data.tags[0]}</span>}
				</p>
			)
		}
	</div>
</article>

<style>
	.card-cover {
		aspect-ratio: 3 / 4;
		overflow: hidden;
		position: relative;
	}

	.cover-img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
		transition: transform 0.5s ease;
	}

	.group:hover .cover-img {
		transform: scale(1.05);
	}

	.card-tag {
		position: absolute;
		bottom: 0.75rem;
		right: 0.75rem;
		display: inline-block;
		padding: 0.25rem 0.5rem;
		font-size: 0.7rem;
		border-radius: 2px;
		background: transparent;
		color: #fff;
		border: 1px solid #fff;
		z-index: 5;
	}

	.tag-inline {
		display: inline-block;
		padding: 0.25rem 0.75rem;
		font-size: 0.75rem;
		border-radius: 4px;
	}

	@media (min-width: 768px) {
		.post-card-no-cover {
			height: 450px !important;
		}
	}
</style>
