---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

type Props = {
	post: CollectionEntry<"post">;
};

const { post } = Astro.props;

const hasExternalImage = (str?: string) => {
	if (!str) return false;
	return str.startsWith("http://") || str.startsWith("https://");
};

const coverSrc = post.data.coverImage?.src;
const ogImage = post.data.ogImage;
---

<article
	class="group relative flex flex-col overflow-hidden rounded-lg border border-accent/20 bg-bgColor transition-all hover:border-accent/40 hover:shadow-lg hover:shadow-accent/5 dark:border-accent-2/20 dark:bg-accent-2/5 dark:hover:border-accent-2/40 dark:hover:shadow-accent-2/5"
>
	<a class="absolute inset-0 z-10" data-astro-prefetch href={`/posts/${post.id}/`}>
		<span class="sr-only">阅读 {post.data.title}</span>
	</a>

	<div class="card-cover">
		{hasExternalImage(ogImage) && <img alt={post.data.title} class="cover-img" src={ogImage} />}

		{
			coverSrc && !hasExternalImage(ogImage) && (
				<Image alt={post.data.coverImage.alt} class="cover-img" src={coverSrc} />
			)
		}
	</div>

	<div class="flex flex-1 flex-col p-4">
		<div class="mb-2 flex items-center gap-2">
			<h2
				class="text-lg font-semibold leading-tight text-accent-2 transition-colors group-hover:text-accent dark:text-accent-2 dark:group-hover:text-accent-2"
			>
				{post.data.title}
			</h2>
			{
				post.data.tags?.length > 0 && (
					<span class="shrink-0 rounded-full bg-accent/10 px-2 py-0.5 text-xs text-accent dark:bg-accent-2/10 dark:text-accent-2">
						{post.data.tags[0]}
					</span>
				)
			}
		</div>

		<p class="line-clamp-2 flex-1 text-sm text-gray-700 dark:text-gray-300">
			{post.data.description}
		</p>

		<div class="mt-4 flex items-center justify-end">
			<span
				class="text-lg text-accent/50 transition-all group-hover:translate-x-1 group-hover:text-accent dark:text-accent-2/50"
			>
				→
			</span>
		</div>
	</div>
</article>

<style>
	.card-cover {
		aspect-ratio: 3 / 4;
		overflow: hidden;
		position: relative;
	}

	.cover-img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
	}
</style>
