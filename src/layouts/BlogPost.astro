---
import { type CollectionEntry, render } from "astro:content";

import Masthead from "@/components/blog/Masthead.astro";
import TOC from "@/components/blog/TOC.astro";
import WebMentions from "@/components/blog/webmentions/index.astro";

import BaseLayout from "./Base.astro";

interface Props {
	post: CollectionEntry<"post">;
}

const { post } = Astro.props;
const { ogImage, title, description, updatedDate, publishDate } = post.data;
const socialImage = ogImage ?? `/og-image/${post.id}.png`;
const articleDate = updatedDate?.toISOString() ?? publishDate.toISOString();
const { headings } = await render(post);
const hasHeadings = headings.length > 0;
---

<BaseLayout
	meta={{
		articleDate,
		description,
		ogImage: socialImage,
		title,
	}}
>
	<div class="lg:flex lg:items-start lg:gap-8">
		<article class="mx-auto max-w-4xl flex-1 break-words px-4 sm:px-0" data-pagefind-body>
			<div id="blog-hero"><Masthead content={post} /></div>
			<div
				class:list={[
					"prose prose-sm prose-cactus mt-12 max-w-none lg:prose-base lg:prose-lg prose-headings:font-semibold prose-headings:text-accent-2 prose-headings:before:absolute prose-headings:before:-ms-4 prose-headings:before:text-accent sm:prose-headings:before:content-['#'] sm:prose-th:before:content-none",
				]}
			>
				<slot />
				<WebMentions />
			</div>
		</article>
		{
			hasHeadings && (
				<div class="hidden lg:block lg:w-64 lg:flex-shrink-0">
					<div class="sticky top-20">
						<TOC headings={headings} />
					</div>
				</div>
			)
		}
	</div>
	<button
		aria-label="Back to Top"
		class="z-90 fixed bottom-8 end-4 flex h-10 w-10 translate-y-28 items-center justify-center rounded-full border-2 border-transparent bg-accent/10 text-3xl text-accent opacity-0 transition-all duration-300 hover:scale-110 hover:border-accent hover:bg-accent/20 data-[show=true]:translate-y-0 data-[show=true]:opacity-100 dark:bg-accent/20 dark:text-accent dark:hover:border-accent dark:hover:bg-accent/30 sm:end-8 sm:h-12 sm:w-12"
		data-show="false"
		id="to-top-btn"
		><svg
			aria-hidden="true"
			class="h-6 w-6"
			fill="none"
			focusable="false"
			stroke="currentColor"
			stroke-width="2"
			viewBox="0 0 24 24"
			xmlns="http://www.w3.org/2000/svg"
		>
			<path d="M4.5 15.75l7.5-7.5 7.5 7.5" stroke-linecap="round" stroke-linejoin="round"></path>
		</svg>
	</button>
</BaseLayout>

<script>
	const scrollBtn = document.getElementById("to-top-btn") as HTMLButtonElement;
	const targetHeader = document.getElementById("blog-hero") as HTMLDivElement;

	function callback(entries: IntersectionObserverEntry[]) {
		entries.forEach((entry) => {
			scrollBtn.dataset.show = (!entry.isIntersecting).toString();
		});
	}

	scrollBtn.addEventListener("click", () => {
		document.documentElement.scrollTo({ behavior: "smooth", top: 0 });
	});

	const observer = new IntersectionObserver(callback);
	observer.observe(targetHeader);

	function blockBilibiliNavigation() {
		const bilibiliIframes = document.querySelectorAll('iframe[src*="bilibili.com"]');

		bilibiliIframes.forEach((iframe) => {
			const src = iframe.src;
			const urlParams = new URLSearchParams(src.split("?")[1] || "");
			const bvid = urlParams.get("bvid") || "";
			const page = urlParams.get("p") || urlParams.get("page") || "1";

			if (bvid && !src.includes("html5mobileplayer")) {
				const mobileSrc = `//www.bilibili.com/blackboard/html5mobileplayer.html?bvid=${bvid}&page=${page}&danmaku=1`;
				iframe.src = mobileSrc;
			}

			const wrapper = document.createElement("div");
			wrapper.className = "bilibili-wrapper";
			iframe.parentNode?.insertBefore(wrapper, iframe);
			wrapper.appendChild(iframe);
		});
	}

	document.addEventListener("DOMContentLoaded", blockBilibiliNavigation);
</script>

<style>
	.no-toc-max {
		max-width: none !important;
	}

	.prose iframe[src*="bilibili.com"],
	iframe[src*="bilibili.com"] {
		display: block;
		width: 100% !important;
		max-width: 100% !important;
		aspect-ratio: 16 / 9;
		min-height: 300px;
		height: auto !important;
		border-radius: 0.5rem;
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
		margin: 1.5rem 0;
	}

	.video-wrap {
		position: relative;
		width: 100%;
		height: 0;
		padding-bottom: 56.25%;
		margin: 1.5rem 0;
		border-radius: 0.5rem;
		overflow: hidden;
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
	}

	.video-wrap iframe {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		border: 0;
		margin: 0;
		min-height: auto !important;
	}

	@media (max-width: 768px) {
		.prose iframe[src*="bilibili.com"],
		iframe[src*="bilibili.com"] {
			min-height: 220px;
			border-radius: 0.25rem;
			margin: 1rem 0;
		}

		.video-wrap {
			border-radius: 0.25rem;
			margin: 1rem 0;
		}
	}

	.bilibili-wrapper {
		position: relative;
		width: 100%;
		border-radius: 0.5rem;
		overflow: hidden;
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
		margin: 1.5rem 0;
	}

	.bilibili-wrapper iframe {
		display: block;
		width: 100%;
		max-width: 100%;
		aspect-ratio: 16 / 9;
		min-height: 300px;
		height: auto;
		border: none;
	}

	@media (max-width: 768px) {
		.bilibili-wrapper {
			margin: 1rem 0;
			border-radius: 0.25rem;
		}

		.bilibili-wrapper iframe {
			min-height: 220px;
		}
	}
</style>
