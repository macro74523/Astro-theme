---
import BaseHead from "@/components/BaseHead.astro";
import SkipLink from "@/components/SkipLink.astro";
import ThemeProvider from "@/components/ThemeProvider.astro";
import Footer from "@/components/layout/Footer.astro";
import Search from "@/components/Search.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import Loading from "@/components/Loading.astro";
import { siteConfig } from "@/site.config";
import type { SiteMeta } from "@/types";

interface Props {
	meta: SiteMeta;
}

const {
	meta: { articleDate, description = siteConfig.description, ogImage, title },
} = Astro.props;
---

<html class="scroll-smooth" lang={siteConfig.lang}>
	<head>
		<BaseHead articleDate={articleDate} description={description} ogImage={ogImage} title={title} />
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.15.3/dist/katex.min.css" />
		<script is:inline src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"
		></script>
	</head>
	<body
		class="mx-auto flex min-h-screen max-w-7xl flex-col bg-bgColor px-1 pt-4 font-mono text-sm font-normal text-textColor antialiased sm:px-3 lg:px-6"
	>
		<Loading />
		<ThemeProvider />
		<SkipLink />
		<header class="relative mb-8 flex items-center justify-end gap-4">
			<a href="/" class="absolute left-1/2 flex -translate-x-1/2 items-center gap-3">
				<span class="text-2xl font-bold">{siteConfig.title}</span>
			</a>
			<div class="flex items-center gap-2">
				<Search />
				<ThemeToggle />
			</div>
		</header>
		<main id="main">
			<slot />
		</main>
		<Footer />
	</body>
</html>
