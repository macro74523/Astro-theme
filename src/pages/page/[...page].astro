---
import { type CollectionEntry } from "astro:content";
import PostCard from "@/components/blog/PostCard.astro";
import Pagination from "@/components/Paginator.astro";
import { getAllPosts } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";
import { collectionDateSort } from "@/utils/date";
import type { GetStaticPaths, Page } from "astro";
export const prerender = true;

const MAX_POSTS_PER_PAGE = 12;

export const getStaticPaths = (async ({ paginate }) => {
	const MAX_POSTS_PER_PAGE = 12;
	const allPosts = await getAllPosts();
	const filteredPosts = allPosts.filter((p) => !p.data.draft && !(p.data.tags || []).includes("示例"));
	console.log(`Total posts: ${allPosts.length}, Filtered posts: ${filteredPosts.length}`);
	return paginate(filteredPosts.sort(collectionDateSort), {
		pageSize: MAX_POSTS_PER_PAGE,
	});
}) satisfies GetStaticPaths;

interface Props {
	page: Page<CollectionEntry<"post">>;
}

const { page } = Astro.props;

const posts = page.data;
const leftColumnPosts = posts.filter((_, index) => index % 2 === 0);
const rightColumnPosts = posts.filter((_, index) => index % 2 === 1);

const allPostsForTags = await getAllPosts();
const allTags = [
	...new Set(allPostsForTags.flatMap((p) => (p.data.tags || []).filter((t) => t !== "示例"))),
];

const totalPages = Math.ceil(page.total / MAX_POSTS_PER_PAGE);
const paginationProps = {
	currentPage: page.currentPage,
	totalPages,
	...(page.url.prev && {
		prevUrl: {
			text: "上一页",
			url: page.url.prev,
		},
	}),
	...(page.url.next && {
		nextUrl: {
			text: "下一页",
			url: page.url.next,
		},
	}),
};
---

<PageLayout meta={{ title: `主页 - 第${page.currentPage}页` }}>
	<section aria-label="Blog post list" class="posts-section">
		<div class="section-header">
			<div class="section-header-left">
				<h2 class="section-title">
					<svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<path
							d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"
						></path>
					</svg>
					作品选集 - 第 {page.currentPage} 页
				</h2>
			</div>
		</div>

		<div class="posts-grid-mobile" id="postsGridMobile">
			<div class="posts-column">
				{
					leftColumnPosts.map((p) => (
						<div class="post-card-wrapper">
							<PostCard post={p} />
						</div>
					))
				}
			</div>
			<div class="posts-column">
				{
					rightColumnPosts.map((p) => (
						<div class="post-card-wrapper">
							<PostCard post={p} />
						</div>
					))
				}
			</div>
		</div>

		<div class="posts-grid-desktop" id="postsGridDesktop">
			{
				posts.map((p) => (
					<div class="post-card-wrapper">
						<PostCard post={p} />
					</div>
				))
			}
		</div>

		<Pagination {...paginationProps} />
	</section>
</PageLayout>

<style>
	.section-header {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		margin-bottom: 1rem;
		gap: 1rem;
	}

	.section-header-left {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.section-title {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 1.125rem;
		font-weight: 600;
		color: var(--accent-2-color);
		margin: 0;
	}

	.icon {
		width: 1.25rem;
		height: 1.25rem;
		color: var(--accent-color);
	}

	.post-card-wrapper {
		display: block;
	}

	.posts-section {
		margin-bottom: 3rem;
	}

	.posts-grid-mobile {
		display: flex;
		gap: 0.375rem;
	}

	.posts-column {
		display: flex;
		flex-direction: column;
		gap: 0.375rem;
		flex: 1;
	}

	.posts-grid-desktop {
		display: none;
	}

	@media (min-width: 768px) {
		.posts-grid-mobile {
			display: none;
		}

		.posts-grid-desktop {
			display: grid;
			gap: 0.5rem;
			grid-template-columns: repeat(3, 1fr);
		}
	}

	@media (min-width: 1024px) {
		.posts-grid-desktop {
			grid-template-columns: repeat(4, 1fr);
			gap: 0.75rem;
		}
	}
</style>
