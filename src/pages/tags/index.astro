---
import { getAllPosts, getUniqueTagsWithCount } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";

const allPosts = await getAllPosts();
const allTags = getUniqueTagsWithCount(allPosts);
export const prerender = true;

const meta = {
	description: "A list of all the topics I've written about in my posts",
	title: "All Tags",
};
---

<PageLayout meta={meta}>
	<h1 class="title mb-6">全部标签</h1>
	<ul class="flex flex-wrap gap-3">
		{
			allTags.map(([tag, _]) => (
				<li>
					<a
						class="tag-cloud-item inline-flex items-center px-[0.875rem] py-[0.375rem] text-sm font-medium rounded-md bg-[rgba(22,101,52,0.08)] text-[#166534] border border-[rgba(22,101,52,0.3)] no-underline transition-all duration-250 hover:bg-[rgba(22,101,52,0.15)] hover:border-[rgba(22,101,52,0.5)] hover:-translate-y-[1px] hover:shadow-[0_2px_8px_rgba(22,101,52,0.12)] dark:bg-[rgba(134,239,172,0.08)] dark:text-[#86efac] dark:border-[rgba(134,239,172,0.3)] dark:hover:bg-[rgba(134,239,172,0.15)] dark:hover:border-[rgba(134,239,172,0.5)] dark:hover:shadow-[0_2px_8px_rgba(134,239,172,0.12)]"
						data-astro-prefetch
						href={`/tags/${tag}/`}
						title={`View posts with the tag: ${tag}`}
					>
						<span class="mr-1">#</span>{tag}
					</a>
				</li>
			))
		}
	</ul>
</PageLayout>
