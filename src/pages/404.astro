---
import PageLayout from "@/layouts/Base.astro";
export const prerender = true;

const meta = {
	description: "页面不存在",
	title: "404 - 页面不存在",
};
---

<PageLayout meta={meta}>
	<div class="not-found">
		<div class="code">404</div>
		<div class="divider"></div>
		<div class="message">
			<h1>页面不存在</h1>
			<p>抱歉，您访问的页面已消失或地址有误</p>
		</div>
		<a href="/" class="back">返回首页</a>
	</div>

	<style>
		.not-found {
			display: flex;
			flex-direction: column;
			align-items: center;
			justify-content: center;
			min-height: 60vh;
			text-align: center;
			padding: 2rem;
		}

		.code {
			font-size: clamp(5rem, 20vw, 12rem);
			font-weight: 700;
			line-height: 1;
			background: linear-gradient(
				135deg,
				var(--accent-color, #22c55e) 0%,
				var(--accent-2-color, #10b981) 100%
			);
			-webkit-background-clip: text;
			-webkit-text-fill-color: transparent;
			background-clip: text;
			opacity: 0.8;
		}

		.divider {
			width: 60px;
			height: 2px;
			background: linear-gradient(90deg, transparent, var(--accent-color, #22c55e), transparent);
			margin: 2rem 0;
		}

		.message h1 {
			font-size: 1.5rem;
			font-weight: 600;
			margin: 0 0 0.5rem;
			color: var(--accent-2-color, #1e293b);
		}

		.dark .message h1 {
			color: var(--accent-2-color, #f1f5f9);
		}

		.message p {
			font-size: 0.95rem;
			color: #64748b;
			margin: 0;
		}

		.back {
			margin-top: 2.5rem;
			padding: 0.75rem 2rem;
			border: 1px solid var(--accent-color, #22c55e);
			border-radius: 2rem;
			color: var(--accent-color, #22c55e);
			text-decoration: none;
			font-size: 0.9rem;
			transition: all 0.3s ease;
		}

		.back:hover {
			background: var(--accent-color, #22c55e);
			color: white;
		}
	</style>
</PageLayout>
