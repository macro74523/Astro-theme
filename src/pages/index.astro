---
import { type CollectionEntry, getCollection } from "astro:content";
import PostCard from "@/components/blog/PostCard.astro";
import SkeletonCard from "@/components/blog/SkeletonCard.astro";
import Note from "@/components/note/Note.astro";
import MusicPlayer from "@/components/MusicPlayer.astro";

import Pagination from "@/components/Paginator.astro";
import { getAllPosts } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";
import { collectionDateSort } from "@/utils/date";
export const prerender = true;

const MAX_POSTS = 12;
const allPosts = await getAllPosts();
const filteredPosts = allPosts.filter(
	(p) => !p.data.draft && !(p.data.tags || []).includes("示例"),
);
const allPostsByDate = filteredPosts
	.sort(collectionDateSort)
	.slice(0, MAX_POSTS) as CollectionEntry<"post">[];

const MAX_NOTES = 10;
const allNotes = await getCollection("note");
const latestNotes = allNotes.sort(collectionDateSort).slice(0, MAX_NOTES);
const totalNotesCount = allNotes.length;

const allTags = [
	...new Set(filteredPosts.flatMap((p) => (p.data.tags || []).filter((t) => t !== "示例"))),
];

const leftColumnPosts = allPostsByDate.filter((_, index) => index % 2 === 0);
const rightColumnPosts = allPostsByDate.filter((_, index) => index % 2 === 1);

const totalPages = Math.ceil(filteredPosts.length / MAX_POSTS);
---

<PageLayout meta={{ title: "主页" }}>
	<section class="intro-section">
		<div class="intro-card">
			<div class="intro-card-top">
				<div class="intro-card-bg"></div>
				<div class="intro-avatar">
					<div class="avatar-circle">
						<img
							src="https://img.cdn1.vip/i/69fe94452c136_1778291781.webp"
							alt="头像"
							class="avatar-img"
						/>
					</div>
				</div>
			</div>
			<div class="intro-bottom-row">
				<div class="intro-content-wrapper">
					<div class="intro-content">
						<h1 class="intro-name">MACRO.WANG</h1>
						<p class="intro-title">摄像师 / 内容创作者</p>
						<p class="intro-description">
							通过电信号把拍摄物体记录下来成像<br />
							Nothing is true, everything is permitted
						</p>
					</div>
				</div>
				<div class="stats-container">
					<div class="stat-column">
						<span class="stat-num">{filteredPosts.length}</span>
						<span class="stat-txt">作品</span>
					</div>
					<div class="stat-column">
						<span class="stat-num">{totalNotesCount}</span>
						<span class="stat-txt">笔记</span>
					</div>
					<div class="stat-column">
						<span class="stat-num">{allTags.length}</span>
						<span class="stat-txt">标签</span>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section aria-label="Blog post list" class="posts-section">
		<div class="section-header">
			<h2 class="section-title">
				<svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<path
						d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"
					></path>
				</svg>
				作品选集
			</h2>
		</div>
		{
			allTags.length > 0 && (
				<div class="tags-nav">
					<button class="tag-nav active" data-tag="">
						全部
					</button>
					{allTags.map((tag) => (
						<button class="tag-nav" data-tag={tag}>
							{tag}
						</button>
					))}
				</div>
			)
		}

		<div class="posts-grid-mobile" id="postsGridMobile">
			<div class="posts-column">
				{
					leftColumnPosts.map((p, index) => (
						<div
							class="post-card-wrapper fade-in-item"
							data-tags={JSON.stringify(p.data.tags || [])}
							style={`animation-delay: ${index * 50}ms`}
						>
							<PostCard post={p} />
						</div>
					))
				}
			</div>
			<div class="posts-column">
				{
					rightColumnPosts.map((p, index) => (
						<div
							class="post-card-wrapper fade-in-item"
							data-tags={JSON.stringify(p.data.tags || [])}
							style={`animation-delay: ${(leftColumnPosts.length + index) * 50}ms`}
						>
							<PostCard post={p} />
						</div>
					))
				}
			</div>
		</div>

		<div class="posts-grid-desktop" id="postsGridDesktop">
			{
				allPostsByDate.map((p, index) => (
					<div
						class="post-card-wrapper fade-in-item"
						data-tags={JSON.stringify(p.data.tags || [])}
						style={`animation-delay: ${index * 50}ms`}
					>
						<PostCard post={p} />
					</div>
				))
			}
		</div>

		{
			totalPages > 1 && (
				<Pagination
					currentPage={1}
					totalPages={totalPages}
					nextUrl={{
						text: "下一页",
						url: "/page/2/",
					}}
				/>
			)
		}
	</section>

	<style>
		.section-header {
			display: flex;
			align-items: flex-start;
			justify-content: space-between;
			margin-bottom: 1rem;
			gap: 1rem;
		}

		.section-header-left {
			display: flex;
			flex-direction: column;
			gap: 0.75rem;
		}

		.section-title {
			display: flex;
			align-items: center;
			gap: 0.5rem;
			font-size: 1.125rem;
			font-weight: 600;
			color: var(--accent-2-color);
			margin: 0;
		}

		.icon {
			width: 1.25rem;
			height: 1.25rem;
			color: var(--accent-color);
		}

		.tags-nav {
			display: flex;
			gap: 1rem;
			align-items: center;
			justify-content: flex-start;
			flex-wrap: wrap;
			margin-bottom: 1.5rem;
			padding: 0.5rem 0;
		}

		.tag-nav {
			font-size: 0.9375rem;
			font-weight: 500;
			color: #9ca3af;
			text-decoration: none;
			position: relative;
			transition: color 0.2s ease;
			padding: 0.375rem 0.75rem;
			background: none;
			border: none;
			cursor: pointer;
			border-radius: 0.5rem;
			white-space: nowrap;
		}

		.tag-nav:hover {
			background: hsl(var(--theme-accent) / 0.1);
		}

		@media (min-width: 768px) {
			.tags-nav {
				gap: 1.5rem;
				margin-bottom: 2rem;
			}

			.tag-nav {
				font-size: 1.125rem;
				padding: 0.25rem 0;
				border-radius: 0;
			}

			.tag-nav:hover {
				background: none;
			}
		}

		.tag-nav:hover {
			color: hsl(var(--theme-accent));
		}

		.tag-nav.active {
			color: hsl(var(--theme-accent));
			font-weight: 600;
		}

		.tag-nav.active::after {
			content: "";
			position: absolute;
			bottom: 0;
			left: 0;
			width: 100%;
			height: 3px;
			background-color: hsl(var(--theme-accent));
			border-radius: 2px;
		}

		.dark .tag-nav,
		[data-theme="dark"] .tag-nav {
			color: #6b7280;
		}

		.dark .tag-nav:hover,
		[data-theme="dark"] .tag-nav:hover {
			color: hsl(var(--theme-accent));
		}

		.dark .tag-nav.active,
		[data-theme="dark"] .tag-nav.active {
			color: hsl(var(--theme-accent));
		}

		.dark .tag-nav.active::after,
		[data-theme="dark"] .tag-nav.active::after {
			background-color: hsl(var(--theme-accent));
		}

		.post-card-wrapper {
			display: block;
		}

		.post-card-wrapper.hidden {
			display: none;
		}

		@keyframes fadeInUp {
			from {
				opacity: 0;
				transform: translateY(20px);
			}
			to {
				opacity: 1;
				transform: translateY(0);
			}
		}

		.fade-in-item {
			opacity: 0;
			animation: fadeInUp 0.5s ease-out forwards;
		}

		.intro-section {
			margin-bottom: 4rem;
			position: relative;
			overflow: visible;
		}

		.intro-card {
			display: flex;
			flex-direction: column;
			position: relative;
			background: transparent;
			border-radius: 0;
			border: none;
		}

		.intro-card-top {
			width: 100%;
			height: 170px;
			position: relative;
			overflow: visible;
		}

		.intro-card-bg {
			width: 100%;
			height: 100%;
			background-image: url("https://img.cdn1.vip/i/69fe834dc0638_1778287437.webp");
			background-size: cover;
			background-position: center 30%;
			background-repeat: no-repeat;
			border-radius: 1rem;
			position: absolute;
			top: 0;
			left: 0;
			overflow: hidden;
		}

		.intro-card-bg::before {
			content: "";
			position: absolute;
			top: 0;
			left: 0;
			width: 100%;
			height: 100%;
			background: linear-gradient(180deg, rgba(0, 0, 0, 0.1) 0%, rgba(0, 0, 0, 0.35) 100%);
			pointer-events: none;
			z-index: 0;
		}

		.intro-avatar {
			position: absolute;
			bottom: -35px;
			left: 15px;
			z-index: 100;
		}

		.avatar-circle {
			width: 70px;
			height: 70px;
			border-radius: 1rem;
			display: flex;
			align-items: center;
			justify-content: center;
			overflow: hidden;
		}

		.avatar-icon {
			font-size: 2rem;
			font-weight: 700;
			color: #fff;
			text-shadow: 0 2px 4px rgba(0, 0, 0, 0.2);
		}

		.avatar-img {
			width: 100%;
			height: 100%;
			object-fit: cover;
		}

		.intro-bottom-row {
			padding-left: 95px;
			padding-top: 10px;
			display: flex;
			flex-direction: column;
		}

		.intro-content-wrapper {
			flex: 1;
		}

		.intro-content {
			text-align: left;
			margin-bottom: 0.75rem;
			margin-top: -0.5rem;
		}

		.intro-name {
			font-size: 1.375rem;
			font-weight: 800;
			color: hsl(var(--theme-text));
			margin: 0 0 0.8rem 0;
			letter-spacing: 0.05em;
		}

		.intro-title {
			font-size: 0.95rem;
			color: hsl(var(--theme-text), 0.7);
			margin: 0 0 0.3rem 0;
			font-weight: 600;
		}

		.intro-description {
			font-size: 0.9rem;
			color: hsl(var(--theme-text), 0.7);
			line-height: 1.6;
			margin: 0;
			font-weight: 500;
		}

		.stats-container {
			display: flex;
			align-items: center;
			justify-content: flex-start;
			width: auto;
			padding-top: 1rem;
			border-top: none;
			gap: 2.25rem;
			margin-left: 95px;
		}

		.stat-column {
			display: flex;
			flex-direction: column;
			align-items: flex-start;
			gap: 0.15rem;
			padding: 0;
			background: transparent;
			border-radius: 0;
		}

		.stat-num {
			font-size: 1.4rem;
			font-weight: 800;
			color: hsl(var(--theme-text));
			line-height: 1;
		}

		.stat-txt {
			font-size: 0.8rem;
			font-weight: 600;
			color: hsl(var(--theme-text), 0.65);
		}

		@media (min-width: 768px) {
			.intro-card-top {
				height: 240px;
				background-position: center 30%;
			}

			.intro-avatar {
				bottom: -50px;
				left: 30px;
			}

			.avatar-circle {
				width: 100px;
				height: 100px;
				border-radius: 1.5rem;
				overflow: hidden;
			}

			.avatar-icon {
				font-size: 2.2rem;
			}

			.intro-bottom-row {
				padding-left: 145px;
				padding-top: 12px;
				display: flex;
				flex-direction: row;
				align-items: flex-start;
				justify-content: space-between;
				gap: 2rem;
			}

			.intro-content-wrapper {
				padding-left: 0;
				padding-top: 0;
				flex: 1;
			}

			.intro-name {
				font-size: 1.875rem;
				margin-bottom: 1rem;
			}

			.intro-title {
				font-size: 1.05rem;
			}

			.intro-description {
				font-size: 0.95rem;
				line-height: 1.7;
			}

			.stats-container {
				margin-left: 0;
				gap: 3rem;
				justify-content: flex-end;
				flex-shrink: 0;
			}

			.stat-column {
				align-items: center;
			}

			.stat-num {
				font-size: 1.875rem;
			}

			.stat-txt {
				font-size: 0.9rem;
			}
		}

		.posts-section {
			margin-bottom: 3rem;
		}

		.posts-grid-mobile {
			display: grid;
			grid-template-columns: repeat(2, 1fr);
			gap: 0.5rem;
		}

		.posts-column {
			display: contents;
		}

		.post-card-wrapper {
			margin-bottom: 0.5rem;
			aspect-ratio: 3 / 4;
		}

		.posts-grid-desktop {
			display: none;
		}

		@media (min-width: 768px) {
			.posts-grid-mobile {
				display: none;
			}

			.posts-grid-desktop {
				display: grid;
				gap: 0.5rem;
				grid-template-columns: repeat(3, 1fr);
			}

			.post-card-wrapper {
				aspect-ratio: 4 / 3;
			}
		}

		@media (min-width: 1024px) {
			.posts-grid-desktop {
				grid-template-columns: repeat(4, 1fr);
				gap: 0.75rem;
			}
		}

		.notes-section {
			margin-top: 2rem;
		}

		.notes-list {
			display: flex;
			flex-direction: column;
			gap: 0.75rem;
			list-style: none;
			padding: 0;
			margin: 0;
		}
	</style>

	<script>
		document.addEventListener("DOMContentLoaded", () => {
			const tagButtons = document.querySelectorAll(".tag-nav");
			const postCardWrappers = document.querySelectorAll(".post-card-wrapper");

			function filterPostsByTag(selectedTag) {
				postCardWrappers.forEach((wrapper) => {
					const tags = JSON.parse(wrapper.dataset.tags);
					if (!selectedTag || tags.includes(selectedTag)) {
						wrapper.classList.remove("hidden");
					} else {
						wrapper.classList.add("hidden");
					}
				});
			}

			tagButtons.forEach((button) => {
				button.addEventListener("click", (e) => {
					e.preventDefault();

					tagButtons.forEach((btn) => btn.classList.remove("active"));

					button.classList.add("active");

					const selectedTag = button.dataset.tag;
					filterPostsByTag(selectedTag);
				});
			});

			const introBg = document.querySelector(".intro-card-bg");
			if (introBg) {
				let mouseX = 0,
					mouseY = 0;
				let prevMouseX = 0,
					prevMouseY = 0;
				let trails = [];
				const maxTrails = 8;

				const mainGlow = document.createElement("div");
				mainGlow.style.cssText = `
					position: absolute;
					width: 120px;
					height: 120px;
					border-radius: 50%;
					background: radial-gradient(circle, rgba(139, 179, 178, 0.35) 0%, transparent 70%);
					pointer-events: none;
					transform: translate(-50%, -50%);
					z-index: 10;
					filter: blur(12px);
					opacity: 0;
					transition: opacity 0.3s ease;
				`;
				introBg.appendChild(mainGlow);

				for (let i = 0; i < maxTrails; i++) {
					const trail = document.createElement("div");
					trail.style.cssText = `
						position: absolute;
						width: 80px;
						height: 80px;
						border-radius: 50%;
						background: radial-gradient(circle, rgba(139, 179, 178, 0.18) 0%, transparent 70%);
						pointer-events: none;
						transform: translate(-50%, -50%);
						z-index: 9;
						filter: blur(10px);
						opacity: 0;
					`;
					introBg.appendChild(trail);
					trails.push({ el: trail, x: 0, y: 0, opacity: 0 });
				}

				introBg.addEventListener("mousemove", (e) => {
					const rect = introBg.getBoundingClientRect();
					mouseX = e.clientX - rect.left;
					mouseY = e.clientY - rect.top;
					mainGlow.style.left = mouseX + "px";
					mainGlow.style.top = mouseY + "px";
					mainGlow.style.opacity = "1";
				});

				introBg.addEventListener("mouseleave", () => {
					mainGlow.style.opacity = "0";
					trails.forEach((t) => (t.opacity = 0));
				});

				const starCount = 22;
				const stars = [];
				for (let i = 0; i < starCount; i++) {
					const star = document.createElement("div");
					const size = Math.random() * 4 + 1.5;
					const sx = Math.random() * 100;
					const sy = Math.random() * 100;
					const twinkleSpeed = Math.random() * 0.025 + 0.008;
					const phase = Math.random() * Math.PI * 2;
					const floatPhaseX = Math.random() * Math.PI * 2;
					const floatPhaseY = Math.random() * Math.PI * 2;
					const floatSpeedX = Math.random() * 0.008 + 0.002;
					const floatSpeedY = Math.random() * 0.006 + 0.001;
					const floatRangeX = Math.random() * 3 + 1;
					const floatRangeY = Math.random() * 2 + 0.8;

					star.style.cssText = `
						position: absolute;
						width: ${size}px;
						height: ${size}px;
						border-radius: 50%;
						background: rgba(255, 255, 255, 0.7);
						pointer-events: none;
						left: ${sx}%;
						top: ${sy}%;
						z-index: 5;
						box-shadow: 0 0 ${size * 3}px rgba(255, 255, 255, 0.55);
					`;
					introBg.appendChild(star);
					stars.push({
						el: star,
						baseX: sx,
						baseY: sy,
						floatPhaseX,
						floatPhaseY,
						floatSpeedX,
						floatSpeedY,
						floatRangeX,
						floatRangeY,
						twinklePhase: phase,
						twinkleSpeed,
					});
				}

				let frameSkip = 0;
				function animate() {
					frameSkip++;
					const dx = mouseX - prevMouseX;
					const dy = mouseY - prevMouseY;
					const speed = Math.sqrt(dx * dx + dy * dy);

					trails.forEach((trail, i) => {
						const targetX = mouseX;
						const targetY = mouseY;
						trail.x += (targetX - trail.x) * 0.15;
						trail.y += (targetY - trail.y) * 0.15;
						trail.opacity = Math.max(0, trail.opacity - 0.08);

						if (speed > 3 && i === 0) {
							trail.opacity = Math.min(0.3, 0.25 + speed * 0.015);
						}

						trail.el.style.left = trail.x + "px";
						trail.el.style.top = trail.y + "px";
						trail.el.style.opacity = trail.opacity;
					});

					if (frameSkip % 2 === 0) {
						stars.forEach((star) => {
							star.twinklePhase += star.twinkleSpeed;
							star.floatPhaseX += star.floatSpeedX;
							star.floatPhaseY += star.floatSpeedY;

							const twinkleOpacity = 0.25 + Math.abs(Math.sin(star.twinklePhase)) * 0.75;
							const floatX = star.baseX + Math.sin(star.floatPhaseX) * star.floatRangeX;
							const floatY = star.baseY + Math.sin(star.floatPhaseY) * star.floatRangeY;

							star.el.style.left = floatX + "%";
							star.el.style.top = floatY + "%";
							star.el.style.opacity = twinkleOpacity;
						});
					}

					prevMouseX = mouseX;
					prevMouseY = mouseY;
					requestAnimationFrame(animate);
				}
				animate();
			}
		});
	</script>

	<MusicPlayer />
</PageLayout>
