---
import { type CollectionEntry, getCollection } from "astro:content";
import PostCard from "@/components/blog/PostCard.astro";
import Note from "@/components/note/Note.astro";
import { getAllPostsWithBilibiliCovers } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";
import { collectionDateSort } from "@/utils/date";
export const prerender = true;

const MAX_POSTS = 6;
const allPostsWithCovers = await getAllPostsWithBilibiliCovers();
const latestPosts = allPostsWithCovers
	.sort((a, b) => collectionDateSort(a.post, b.post))
	.slice(0, MAX_POSTS);

const MAX_NOTES = 0;
const allNotes = await getCollection("note");
const latestNotes = allNotes.sort(collectionDateSort).slice(0, MAX_NOTES);
---

<PageLayout meta={{ title: "主页" }}>
	<section aria-label="Blog post list" class="mb-12">
		<h2 class="title mb-8 text-xl text-accent"><a href="/posts/">最近文章</a></h2>
		<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
			{
				latestPosts.map((item) => (
					<PostCard post={item.post} coverUrl={item.bilibiliCover} />
				))
			}
		</div>
		<h2 class="mt-8 grid gap-2 text-lg sm:grid-cols-[auto_1fr]">
			<a class="underline-offset-4 sm:hover:underline" href="/posts/">更多...</a>
		</h2>
	</section>
	{
		latestNotes.length > 0 && (
			<section class="mt-16">
				<h2 class="title mb-6 text-xl text-accent">
					<a href="/notes/">笔记</a>
				</h2>
				<ul class="space-y-4" role="list">
					{latestNotes.map((note) => (
						<li>
							<Note note={note} as="h3" isPreview />
						</li>
					))}
				</ul>
			</section>
		)
	}
</PageLayout>