---
import { type CollectionEntry, getCollection } from "astro:content";
import PostCard from "@/components/blog/PostCard.astro";
import Note from "@/components/note/Note.astro";
import { getAllPosts } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";
import { collectionDateSort } from "@/utils/date";
export const prerender = true;

const MAX_POSTS = 6;
const allPosts = await getAllPosts();
const allPostsByDate = allPosts
	.sort(collectionDateSort)
	.slice(0, MAX_POSTS) as CollectionEntry<"post">[];

const MAX_NOTES = 0;
const allNotes = await getCollection("note");
const latestNotes = allNotes.sort(collectionDateSort).slice(0, MAX_NOTES);

const allTags = [...new Set(allPosts.flatMap((p) => p.data.tags || []))];
---

<PageLayout meta={{ title: "主页" }}>
	<section aria-label="Blog post list" class="posts-section">
		<div class="section-header">
			<h2 class="section-title">
				<svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<path
						d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"
					></path>
				</svg>
				最近文章
			</h2>
			<a href="/posts/" class="more-link">查看全部 →</a>
		</div>

		{
			allTags.length > 0 && (
				<div class="tags-bar">
					<span class="tags-label">标签：</span>
					<div class="tags-list">
						{allTags.map((tag) => (
							<a href={`/tags/${tag}`} class="tag">
								{tag}
							</a>
						))}
					</div>
				</div>
			)
		}

		<div class="posts-grid">
			{allPostsByDate.map((p) => <PostCard post={p} />)}
		</div>
	</section>

	{
		latestNotes.length > 0 && (
			<section class="notes-section">
				<div class="section-header">
					<h2 class="section-title">
						<svg
							class="icon"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
						>
							<path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
							<path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" />
						</svg>
						笔记
					</h2>
					<a href="/notes/" class="more-link">
						查看全部 →
					</a>
				</div>
				<ul class="notes-list" role="list">
					{latestNotes.map((note) => (
						<li>
							<Note note={note} as="h3" isPreview />
						</li>
					))}
				</ul>
			</section>
		)
	}
</PageLayout>

<style>
	.section-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 1rem;
	}

	.section-title {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 1.125rem;
		font-weight: 600;
		color: var(--accent-2-color);
		margin: 0;
	}

	.icon {
		width: 1.25rem;
		height: 1.25rem;
		color: var(--accent-color);
	}

	.more-link {
		font-size: 0.875rem;
		color: var(--accent-color);
		text-decoration: none;
		transition: opacity 0.2s;
	}

	.more-link:hover {
		opacity: 0.7;
	}

	.tags-bar {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 1.5rem;
		flex-wrap: wrap;
	}

	.tags-label {
		font-size: 0.875rem;
		color: #64748b;
		font-weight: 500;
	}

	.tags-list {
		display: flex;
		gap: 0.5rem;
		flex-wrap: wrap;
	}

	.tag {
		display: inline-block;
		padding: 0.25rem 0.75rem;
		font-size: 0.75rem;
		border-radius: 9999px;
		background: var(--accent-color);
		color: white;
		opacity: 0.8;
		transition: opacity 0.2s;
		text-decoration: none;
	}

	.tag:hover {
		opacity: 1;
	}

	.posts-section {
		margin-bottom: 3rem;
	}

	.posts-grid {
		display: grid;
		gap: 0.75rem;
		grid-template-columns: repeat(2, 1fr);
	}

	@media (min-width: 768px) {
		.posts-grid {
			grid-template-columns: repeat(3, 1fr);
			gap: 0.75rem;
		}
	}

	@media (min-width: 1024px) {
		.posts-grid {
			grid-template-columns: repeat(4, 1fr);
		}
	}

	.notes-section {
		margin-top: 2rem;
	}

	.notes-list {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		list-style: none;
		padding: 0;
		margin: 0;
	}
</style>
