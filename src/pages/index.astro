---
import { type CollectionEntry, getCollection } from "astro:content";
import PostCard from "@/components/blog/PostCard.astro";
import Note from "@/components/note/Note.astro";
import UpdateCalendar from "@/components/UpdateCalendar.astro";
import { getAllPosts } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";
import { collectionDateSort } from "@/utils/date";
export const prerender = true;

const MAX_POSTS = 12;
const allPosts = await getAllPosts();
// 过滤掉带有"示例"标签的文章
const filteredPosts = allPosts.filter((p) => !(p.data.tags || []).includes("示例"));
const allPostsByDate = filteredPosts
	.sort(collectionDateSort)
	.slice(0, MAX_POSTS) as CollectionEntry<"post">[];

const MAX_NOTES = 0;
const allNotes = await getCollection("note");
const latestNotes = allNotes.sort(collectionDateSort).slice(0, MAX_NOTES);

// 过滤掉"示例"标签
const allTags = [
	...new Set(filteredPosts.flatMap((p) => (p.data.tags || []).filter((t) => t !== "示例"))),
];

const leftColumnPosts = allPostsByDate.filter((_, index) => index % 2 === 0);
const rightColumnPosts = allPostsByDate.filter((_, index) => index % 2 === 1);
---

<PageLayout meta={{ title: "主页" }}>
	<section aria-label="Blog post list" class="posts-section">
		<div class="section-header">
			<div class="section-header-left">
				<h2 class="section-title">
					<svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<path
							d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"
						></path>
					</svg>
					作品选集
				</h2>
			</div>
		</div>
		{
			allTags.length > 0 && (
				<div class="tags-nav">
					<button class="tag-nav active" data-tag="">
						全部
					</button>
					{allTags.map((tag) => (
						<button class="tag-nav" data-tag={tag}>
							{tag}
						</button>
					))}
				</div>
			)
		}

		<div class="posts-grid-mobile" id="postsGridMobile">
			<div class="posts-column">
				{
					leftColumnPosts.map((p) => (
						<div class="post-card-wrapper" data-tags={JSON.stringify(p.data.tags || [])}>
							<PostCard post={p} />
						</div>
					))
				}
			</div>
			<div class="posts-column">
				{
					rightColumnPosts.map((p) => (
						<div class="post-card-wrapper" data-tags={JSON.stringify(p.data.tags || [])}>
							<PostCard post={p} />
						</div>
					))
				}
			</div>
		</div>

		<div class="posts-grid-desktop" id="postsGridDesktop">
			{
				allPostsByDate.map((p) => (
					<div class="post-card-wrapper" data-tags={JSON.stringify(p.data.tags || [])}>
						<PostCard post={p} />
					</div>
				))
			}
		</div>
	</section>

	{
		latestNotes.length > 0 && (
			<section class="notes-section">
				<div class="section-header">
					<h2 class="section-title">
						<svg
							class="icon"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
						>
							<path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
							<path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" />
						</svg>
						笔记
					</h2>
					<a href="/notes/" class="more-link">
						查看全部 →
					</a>
				</div>
				<ul class="notes-list" role="list">
					{latestNotes.map((note) => (
						<li>
							<Note note={note} as="h3" isPreview />
						</li>
					))}
				</ul>
			</section>
		)
	}

	<UpdateCalendar />
</PageLayout>

<style>
	.section-header {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		margin-bottom: 1rem;
		gap: 1rem;
	}

	.section-header-left {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.section-title {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 1.125rem;
		font-weight: 600;
		color: var(--accent-2-color);
		margin: 0;
	}

	.icon {
		width: 1.25rem;
		height: 1.25rem;
		color: var(--accent-color);
	}

	.tags-nav {
		display: flex;
		gap: 1.5rem;
		align-items: center;
		justify-content: flex-start;
		flex-wrap: wrap;
		margin-bottom: 2rem;
	}

	.tag-nav {
		font-size: 1.125rem;
		font-weight: 500;
		color: #9ca3af;
		text-decoration: none;
		position: relative;
		transition: color 0.2s ease;
		padding-bottom: 0.25rem;
		background: none;
		border: none;
		cursor: pointer;
		padding: 0.25rem 0;
	}

	.tag-nav:hover {
		color: hsl(var(--theme-accent));
	}

	.tag-nav.active {
		color: hsl(var(--theme-accent));
		font-weight: 600;
	}

	.tag-nav.active::after {
		content: "";
		position: absolute;
		bottom: 0;
		left: 0;
		width: 100%;
		height: 3px;
		background-color: hsl(var(--theme-accent));
		border-radius: 2px;
	}

	.dark .tag-nav,
	[data-theme="dark"] .tag-nav {
		color: #6b7280;
	}

	.dark .tag-nav:hover,
	[data-theme="dark"] .tag-nav:hover {
		color: hsl(var(--theme-accent));
	}

	.dark .tag-nav.active,
	[data-theme="dark"] .tag-nav.active {
		color: hsl(var(--theme-accent));
	}

	.dark .tag-nav.active::after,
	[data-theme="dark"] .tag-nav.active::after {
		background-color: hsl(var(--theme-accent));
	}

	.post-card-wrapper {
		display: block;
	}

	.post-card-wrapper.hidden {
		display: none;
	}

	.posts-section {
		margin-bottom: 3rem;
	}

	.posts-grid-mobile {
		display: flex;
		gap: 0.375rem;
	}

	.posts-column {
		display: flex;
		flex-direction: column;
		gap: 0.375rem;
		flex: 1;
	}

	.posts-grid-desktop {
		display: none;
	}

	@media (min-width: 768px) {
		.posts-grid-mobile {
			display: none;
		}

		.posts-grid-desktop {
			display: grid;
			gap: 0.5rem;
			grid-template-columns: repeat(3, 1fr);
		}
	}

	@media (min-width: 1024px) {
		.posts-grid-desktop {
			grid-template-columns: repeat(4, 1fr);
			gap: 0.75rem;
		}
	}

	.notes-section {
		margin-top: 2rem;
	}

	.notes-list {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		list-style: none;
		padding: 0;
		margin: 0;
	}
</style>

<script>
	document.addEventListener("DOMContentLoaded", () => {
		const tagButtons = document.querySelectorAll(".tag-nav");
		const postCardWrappers = document.querySelectorAll(".post-card-wrapper");

		function filterPostsByTag(selectedTag) {
			postCardWrappers.forEach((wrapper) => {
				const tags = JSON.parse(wrapper.dataset.tags);
				if (!selectedTag || tags.includes(selectedTag)) {
					wrapper.classList.remove("hidden");
				} else {
					wrapper.classList.add("hidden");
				}
			});
		}

		tagButtons.forEach((button) => {
			button.addEventListener("click", (e) => {
				e.preventDefault();

				// Remove active class from all buttons
				tagButtons.forEach((btn) => btn.classList.remove("active"));

				// Add active class to clicked button
				button.classList.add("active");

				// Filter posts
				const selectedTag = button.dataset.tag;
				filterPostsByTag(selectedTag);
			});
		});
	});
</script>
